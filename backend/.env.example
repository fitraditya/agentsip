# agentsip engine configuration. Copy to .env and fill in.
#
# Generate FIELD_ENCRYPTION_KEY with:
#   openssl rand -base64 32

# --- Postgres ---------------------------------------------------------------

# Main schema: users, api_keys, trunks, calls, turns, knowledge_bases,
# documents. Apply with: make migrate-up
DATABASE_URL=postgres://agentsip:password@127.0.0.1:5432/agentsip?sslmode=disable

# Vector store (pgvector): chunks table only. Leave unset to use DATABASE_URL
# — a knowledge base's own domain.VectorStoreConfig.DSN can still override
# this per-knowledge-base at runtime for one bringing its own Postgres.
# If set, it must point at a Postgres instance with the `vector` extension
# available — apply its schema with: make migrate-vectorstore-up
#VECTORSTORE_DATABASE_URL=

# --- Secrets -----------------------------------------------------------------

# 32 raw bytes, base64-encoded. Encrypts trunk/knowledge-base provider
# secrets (API keys, SIP digest passwords) at rest. There is no plaintext
# fallback — required.
FIELD_ENCRYPTION_KEY=

# Seed exactly one admin user on first boot, if and only if the database
# currently has zero users — otherwise both are ignored. Leave both unset to
# skip seeding entirely (e.g. if you'll create the first user some other
# way).
#SEED_ADMIN_EMAIL=
#SEED_ADMIN_PASSWORD=

# --- Shutdown ------------------------------------------------------------------

# How long a shutdown waits for calls already in progress to end before
# hanging up whatever is left. New calls are refused immediately on shutdown
# (SIP 503); this only bounds the wait for calls already up. 0 skips the
# wait entirely and drops every live call, matching the old behavior.
SHUTDOWN_DRAIN_TIMEOUT=30s

# --- Email (verification / password reset) ------------------------------------

# An empty SMTP_HOST disables email entirely — registration and password
# reset still work without it, they just don't send a link; see
# internal/adapter/mail's doc comment. All of this is only needed for
# POST /register, /resend-verification, and /password-reset/request to
# actually deliver mail.
#SMTP_HOST=
SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
# Required if SMTP_HOST is set. The From address on every email this process
# sends.
#SMTP_FROM=
# STARTTLS before authenticating — on by default. Only turn off against a
# relay that genuinely cannot do TLS.
SMTP_STARTTLS=true
# For a self-hosted relay with a private certificate authority. Leave off
# otherwise — it disables certificate validation.
SMTP_INSECURE_SKIP_VERIFY=false

# Prefixed to verification/reset tokens to build a clickable link in the
# email (PUBLIC_BASE_URL + "/verify-email?token=..."), pointing at whatever
# web frontend handles those pages. Leave unset to put the raw token in the
# email instead — the API endpoints work identically either way.
#PUBLIC_BASE_URL=

# --- HTTP admin API -----------------------------------------------------------

HTTP_ADDR=:8080

# Comma-separated browser origins allowed to call this API cross-origin
# (e.g. the agentsip web frontend's dev server or production domain). Unset
# allows any origin — safe here since every route authenticates via an
# Authorization: Bearer header, never a cookie.
#CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- SIP / RTP ---------------------------------------------------------------

SIP_LISTEN_ADDR=:5060

# The address FreePBX/the PBX/carrier will reach this host at — used in the
# SIP Contact header and every SDP answer. Must be a real, externally
# reachable IP or hostname; never localhost/127.0.0.1 outside a same-host
# test. Getting this wrong looks like "the call connects but there's no
# audio," not an obvious error.
SIP_ADVERTISE_HOST=

# Interface RTP sockets bind on. 0.0.0.0 is almost always right; narrow it
# only if this host has multiple interfaces and you want RTP on one specific
# one.
RTP_BIND_IP=0.0.0.0

# Bounded RTP port range — open exactly this range (udp) in your firewall
# alongside SIP_LISTEN_ADDR's port.
RTP_PORT_MIN=16384
RTP_PORT_MAX=32767

# --- STT tuning (ElevenLabs) -----------------------------------------------------
# For high-latency VPS (Indonesia -> US), smaller values commit faster.
# US VPS can use larger values for better accuracy.
# Defaults are tuned for APAC high-latency.
STT_FLUSH_BYTES=320
STT_FLUSH_INTERVAL=80ms
STT_MIN_COMMIT_BYTES=640
STT_COMMIT_SILENCE=500ms
STT_SPEECH_THRESHOLD=150

# --- Logging -------------------------------------------------------------------

LOG_LEVEL=info
# JSON output — on by default, what a log aggregator wants. Set to false for
# human-readable text during local debugging.
LOG_JSON=true
# Phone-number masking in logs: off (default), masked, or full. Only change
# to "full" for a bounded troubleshooting window — it puts caller/callee
# numbers into logs unmasked.
LOG_PARAMETERS=off
